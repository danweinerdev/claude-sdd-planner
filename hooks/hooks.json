{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/sdd\" hook sessionstart",
            "timeout": 10,
            "statusMessage": "Loading decision ledger..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/sdd.exe\" hook sessionstart",
            "timeout": 10,
            "statusMessage": "Loading decision ledger..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/sdd\" hook pretooluse",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/sdd.exe\" hook pretooluse",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
