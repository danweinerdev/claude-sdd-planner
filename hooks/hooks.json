{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/load-decisions.sh\"",
            "timeout": 10,
            "statusMessage": "Loading decision ledger..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/reviewer-bash-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
