# Generated dashboard
Dashboard/

# Local config (paths, not committed)
planning-config.local.json

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Editor
*.swp
*.swo
*~
.idea
.idea/
.vscode
.vscode/

# Claude Code sandbox artifacts.
# The sandbox mounts the user's shell/tool config into the repo root, so these
# surface as untracked noise and can be swept into a commit by `git add -A`.
# None of them belong to the plugin.
#
# NOTE: `.claude/` is ignored here because in this repo it is sandbox-local
# setup. If this project ever needs checked-in project-scoped Claude config
# (agents, hooks, settings), negate the specific file — e.g. `!.claude/settings.json`
# — rather than dropping this rule.
.claude/
.mcp.json
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.gitconfig
.ripgreprc
# Sandbox-mounted, not this repo's. If real submodules are ever added, drop
# this line — `.gitmodules` must be committed for submodules to work.
.gitmodules

# Go compilation output: `make build` writes build/<goos>-<goarch>/sdd, and
# `make build-all` fills one directory per release platform.
build/
# Deployment location, not build output: /setup copies the resolved binary to
# ${CLAUDE_PLUGIN_ROOT}/bin/sdd[.exe] because hooks.json can only interpolate
# ${CLAUDE_PLUGIN_ROOT} and cannot resolve PATH (FR-37, which requires this be
# git-ignored). Distinct from build/ — do not merge the two.
bin/
# `go build ./cmd/sdd` with no -o drops the binary in the repo root.
/sdd
/sdd.exe

# Advisory lock sidecars created by `sdd` while reading or writing artifacts.
# They carry no content — only lock state — and are recreated on demand, so a
# stale one is harmless and none should ever be committed.
*.sdd-lock

# hooks.json is generated per-platform by `sdd provision` (run by /setup).
# Shipping one would name an interpreter that does not exist on some
# platforms, and every listed hook command runs on every platform.
hooks/hooks.json
