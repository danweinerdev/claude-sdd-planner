{
  "type": "plan",
  "additionalSections": "allowed",
  "frontmatterMode": "preserve",
  "frontmatter": [
    {
      "key": "title",
      "ownership": "author",
      "required": true
    },
    {
      "key": "type",
      "ownership": "tool",
      "required": true,
      "fixed": "plan"
    },
    {
      "key": "status",
      "ownership": "tool",
      "required": true,
      "enum": [
        "draft",
        "approved",
        "active",
        "complete",
        "archived"
      ]
    },
    {
      "key": "created",
      "ownership": "tool",
      "required": true
    },
    {
      "key": "updated",
      "ownership": "tool",
      "required": true
    },
    {
      "key": "tags",
      "ownership": "author",
      "required": true,
      "default": "[]"
    },
    {
      "key": "related",
      "ownership": "author",
      "required": true,
      "default": "[]"
    },
    {
      "key": "phases",
      "ownership": "author",
      "required": true,
      "default": "[]",
      "doc": "The plan's phases, each a mapping of id/title/doc/status/depends_on. SDD052 requires a list; `phases: []` is the empty form."
    },
    {
      "key": "waivers",
      "ownership": "author",
      "required": false,
      "doc": "Accepted exceptions: entries of {code, reason, accepted}. A listed finding is still reported, as WAIVED with its reason, but stops making the root invalid. Waiving a parse-stage code is refused, an unexplained waiver is refused (SDD176), and a waiver matching nothing is reported as stale (SDD177).",
      "default": "[]"
    }
  ],
