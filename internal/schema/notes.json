{
  "type": "notes",
  "additionalSections": "allowed",
  "frontmatterMode": "preserve",
  "docNote": "Working notes. Body is one H2 per topic; no section structure is imposed.",
  "frontmatter": [
    {
      "key": "title",
      "ownership": "author",
      "required": true
    },
    {
      "key": "type",
      "ownership": "tool",
      "required": true,
      "fixed": "notes"
    },
    {
      "key": "status",
      "ownership": "tool",
      "required": true,
      "enum": [
        "draft",
        "in-progress",
        "complete"
      ]
    },
    {
      "key": "created",
      "ownership": "tool",
      "required": true
    },
    {
      "key": "updated",
      "ownership": "tool",
      "required": true
    },
    {
      "key": "tags",
      "ownership": "author",
      "required": false,
      "default": "[]"
    },
    {
      "key": "related",
      "ownership": "author",
      "required": false,
      "default": "[]"
    }
  ],
  "headings": [],
  "namespaces": []
}
