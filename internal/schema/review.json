{
  "type": "review",
  "additionalSections": "allowed",
  "frontmatterMode": "preserve",
  "frontmatter": [
    {
      "key": "title",
      "ownership": "author",
      "required": true
    },
    {
      "key": "type",
      "ownership": "tool",
      "required": true,
      "fixed": "review"
    },
    {
      "key": "status",
      "ownership": "tool",
      "required": true,
      "enum": [
        "open",
        "resolved",
        "superseded"
      ]
    },
    {
      "key": "created",
      "ownership": "tool",
      "required": true
    },
    {
      "key": "updated",
      "ownership": "tool",
      "required": true
    },
    {
      "key": "tags",
      "ownership": "author",
      "required": true,
      "default": "[]"
    },
    {
      "key": "related",
      "ownership": "author",
      "required": true,
      "default": "[]"
    },
    {
      "key": "review_of",
      "ownership": "author",
      "required": true
    },
    {
      "key": "rev",
      "ownership": "author",
      "required": true
    },
    {
      "key": "findings",
      "ownership": "author",
      "required": false,
      "default": "[]"
    },
    {
      "key": "followups",
      "ownership": "author",
      "required": false,
      "default": "[]"
    },
    {
      "key": "review_scope",
      "ownership": "author",
      "required": false
    },
    {
      "key": "frozen",
      "ownership": "author",
      "required": false
    },
    {
      "key": "verdict",
      "ownership": "author",
      "required": false
    },
    {
      "key": "reviewed_planning_revision",
      "ownership": "author",
      "required": false
    },
    {
      "key": "review_mode",
      "ownership": "author",
      "required": false
    },
    {
      "key": "lane_results",
      "ownership": "author",
      "required": false,
      "default": "[]"
    },
    {
      "key": "superseded_by",
      "ownership": "author",
      "required": false
    },
    {
      "key": "waivers",
      "ownership": "author",
      "required": false,
      "doc": "Accepted exceptions: entries of {code, reason, accepted}. A listed finding is still reported, as WAIVED with its reason, but stops making the root invalid. Waiving a parse-stage code is refused, an unexplained waiver is refused (SDD176), and a waiver matching nothing is reported as stale (SDD177).",
      "default": "[]"
    }
  ],
  "headings": [
    {
      "text": "## Findings",
      "depth": 2,
      "required": true,
      "freeProse": true,
      "defaultBody": "TODO: section inserted by `sdd migrate`; content required by the schema."
    },
    {
      "text": "## Resolution Log",
      "depth": 2,
      "required": true,
      "freeProse": true,
      "defaultBody": "TODO: section inserted by `sdd migrate`; content required by the schema."
    }
  ],
  "namespaces": [
    {
      "name": "F",
      "prefix": "F",
      "width": 2
    },
    {
      "name": "FU",
      "prefix": "FU",
      "width": 2
    }
  ]
}
