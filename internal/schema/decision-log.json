{
  "type": "decision-log",
  "additionalSections": "allowed",
  "frontmatterMode": "preserve",
  "frontmatter": [
    {
      "key": "title",
      "ownership": "author",
      "required": true
    },
    {
      "key": "type",
      "ownership": "tool",
      "required": true,
      "fixed": "decision-log"
    },
    {
      "key": "status",
      "ownership": "tool",
      "required": true,
      "enum": [
        "active",
        "archived"
      ]
    },
    {
      "key": "created",
      "ownership": "tool",
      "required": true
    },
    {
      "key": "updated",
      "ownership": "tool",
      "required": true
    },
    {
      "key": "tags",
      "ownership": "author",
      "required": true,
      "default": "[]"
    },
    {
      "key": "related",
      "ownership": "author",
      "required": false
    },
    {
      "key": "decisions",
      "ownership": "author",
      "required": false,
      "entry": {
        "fields": [
          {
            "key": "id",
            "required": true,
            "pattern": "D-\\d{4,}"
          },
          {
            "key": "kind",
            "required": true,
            "enum": ["decision", "definition", "answered-question", "assumption"]
          },
          {
            "key": "status",
            "required": true,
            "enum": ["proposed", "accepted", "rejected", "superseded"]
          },
          {
            "key": "date",
            "required": true
          },
          {
            "key": "decided_by",
            "required": true,
            "enum": ["agent", "user", "user-approved"],
            "forbiddenWhen": {
              "field": "status",
              "values": ["proposed"],
              "not": true,
              "value": "agent"
            }
          },
          {
            "key": "statement",
            "required": true
          },
          {
            "key": "rationale",
            "required": true
          },
          {
            "key": "question",
            "required": false,
            "requiredWhen": {
              "field": "kind",
              "values": ["answered-question"]
            }
          }
        ]
      }
    }
  ],
  "headings": [],
  "namespaces": [
    {
      "name": "D",
      "prefix": "D",
      "width": 4
    }
  ]
}
